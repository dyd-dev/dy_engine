@@ -0,0 +1,21 @@
+#pragma once
+#include <stdio.h>
+#ifdef _WIN32
+#include <windows.h>
+#include <string>
+#endif
+namespace tracy {
+inline FILE* EmbeddedFileOpen( const char* name, const char* mode ) {
+#ifdef _WIN32
+    const int count = MultiByteToWideChar( CP_UTF8, MB_ERR_INVALID_CHARS, name, -1, nullptr, 0 );
+    if( count <= 0 ) return nullptr;
+    std::wstring path( count, L'\0' );
+    if( !MultiByteToWideChar( CP_UTF8, MB_ERR_INVALID_CHARS, name, -1, path.data(), count ) ) return nullptr;
+    std::wstring wideMode;
+    for( const char* p = mode; *p; ++p ) wideMode += wchar_t( *p );
+    return _wfopen( path.c_str(), wideMode.c_str() );
+#else
+    return fopen( name, mode );
+#endif
+}
+}
