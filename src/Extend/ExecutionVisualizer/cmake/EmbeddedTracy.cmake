add_executable(dy_tracy_embed EXCLUDE_FROM_ALL
    "${dy_viewer_tracy_original}/profiler/helpers/embed.cpp"
    "${dy_viewer_tracy_original}/public/common/tracy_lz4.cpp"
    "${dy_viewer_tracy_original}/public/common/tracy_lz4hc.cpp")
