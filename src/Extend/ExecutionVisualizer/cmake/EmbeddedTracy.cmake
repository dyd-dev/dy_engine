set(dy_tracy_generated "${CMAKE_CURRENT_BINARY_DIR}/tracy-generated")
file(MAKE_DIRECTORY "${dy_tracy_generated}/data")
function(dy_embed_tracy_data name path)
    add_custom_command(OUTPUT "${dy_tracy_generated}/data/${name}.cpp" "${dy_tracy_generated}/data/${name}.hpp"
        COMMAND dy_tracy_embed "${name}" "${dy_viewer_tracy_original}/${path}" "${dy_tracy_generated}/data/${name}"
        DEPENDS dy_tracy_embed "${dy_viewer_tracy_original}/${path}" VERBATIM)
    target_sources(dy_viewer_embedded_tracy PRIVATE "${dy_tracy_generated}/data/${name}.cpp")
endfunction()
