# Reuse Tracy's DXT1 decoder verbatim in the RHI adapter.
file(READ "${dy_viewer_tracy_original}/profiler/src/profiler/TracyTexture.cpp" dy_tracy_texture)
string(FIND "${dy_tracy_texture}" "static tracy_force_inline void DecodeDxt1Part" dy_decode_begin)
string(FIND "${dy_tracy_texture}" "void UpdateTexture(" dy_decode_end)
math(EXPR dy_decode_length "${dy_decode_end}-${dy_decode_begin}")
string(SUBSTRING "${dy_tracy_texture}" ${dy_decode_begin} ${dy_decode_length} dy_decode)
file(WRITE "${dy_tracy_generated}/TracyDxt1.inl" "// Tracy v0.13.1, BSD-3-Clause; see bundled licenses.\n${dy_decode}")
set(dy_tracy_licenses "${CMAKE_CURRENT_BINARY_DIR}/tracy-licenses")
file(MAKE_DIRECTORY "${dy_tracy_licenses}")
file(COPY "${dy_viewer_tracy_original}/LICENSE" DESTINATION "${dy_tracy_licenses}")
file(COPY "${dy_viewer_tracy_original}/profiler/src/font" DESTINATION "${dy_tracy_licenses}" FILES_MATCHING PATTERN "*LICENSE*" PATTERN "*OFL*" PATTERN "*.txt")
file(COPY "${CMAKE_CURRENT_LIST_DIR}/licenses/" DESTINATION "${dy_tracy_licenses}/fonts")
foreach(dependency IN ITEMS capstone zstd json md4c nfd ppqsort)
    file(GLOB notices "${dy_tracy_${dependency}_SOURCE_DIR}/LICENSE*" "${dy_tracy_${dependency}_SOURCE_DIR}/COPYING*")
    file(MAKE_DIRECTORY "${dy_tracy_licenses}/${dependency}")
    file(COPY ${notices} DESTINATION "${dy_tracy_licenses}/${dependency}")
endforeach()
file(GLOB dy_tracy_fonts "${dy_viewer_tracy_original}/profiler/src/font/*.ttf" "${dy_viewer_tracy_original}/profiler/src/font/*.otf")
file(WRITE "${dy_tracy_licenses}/font-sha256.txt" "Tracy v0.13.1 original embedded fonts, unchanged:\n")
foreach(font IN LISTS dy_tracy_fonts)
    file(SHA256 "${font}" font_hash)
    get_filename_component(font_name "${font}" NAME)
    file(APPEND "${dy_tracy_licenses}/font-sha256.txt" "${font_hash}  ${font_name}\n")
endforeach()
add_custom_command(TARGET dy_viewer_embedded_tracy POST_BUILD
    COMMAND "${CMAKE_COMMAND}" -E copy_directory "${dy_tracy_licenses}" "$<TARGET_FILE_DIR:dy_viewer_embedded_tracy>/licenses/Tracy" VERBATIM)
