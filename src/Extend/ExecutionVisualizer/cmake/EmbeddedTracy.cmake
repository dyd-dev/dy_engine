enable_language(C)
FetchContent_GetProperties(tracy SOURCE_DIR dy_viewer_tracy_original)
if(NOT dy_viewer_tracy_original)
    message(FATAL_ERROR "Embedded Tracy needs the pinned Tracy source populated by Dependencies.cmake")
endif()
include("${dy_viewer_tracy_original}/cmake/version.cmake")
if(NOT TRACY_VERSION_STRING STREQUAL "0.13.1")
    message(FATAL_ERROR "The embedded Tracy adapter supports exactly v0.13.1")
endif()

# Patch a private build copy. Never edit a FetchContent override or another build's cache.
set(dy_viewer_tracy_SOURCE_DIR "${CMAKE_CURRENT_BINARY_DIR}/tracy-v0.13.1-embedded")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_LIST_DIR}/../patches/tracy-v0.13.1-embedded.patch")
find_package(Git REQUIRED)
file(SHA256 "${CMAKE_CURRENT_LIST_DIR}/../patches/tracy-v0.13.1-embedded.patch" dy_tracy_patch_hash)
set(dy_tracy_source_key "${dy_viewer_tracy_original}|v0.13.1|${dy_tracy_patch_hash}")
set(dy_tracy_stamp "${dy_viewer_tracy_SOURCE_DIR}/embedded-source.stamp")
set(dy_tracy_previous_key "")
if(EXISTS "${dy_tracy_stamp}")
    file(READ "${dy_tracy_stamp}" dy_tracy_previous_key)
endif()
if(NOT dy_tracy_previous_key STREQUAL dy_tracy_source_key)
    set(dy_tracy_stage "${CMAKE_CURRENT_BINARY_DIR}/tracy-patch-stage")
    file(MAKE_DIRECTORY "${dy_tracy_stage}/cmake")
    file(REMOVE "${dy_tracy_stage}/server/TracyEmbeddedFile.hpp")
    file(COPY "${dy_viewer_tracy_original}/profiler" "${dy_viewer_tracy_original}/server"
        "${dy_viewer_tracy_original}/public" "${dy_viewer_tracy_original}/dtl" DESTINATION "${dy_tracy_stage}")
    file(COPY "${dy_viewer_tracy_original}/cmake/server.cmake" DESTINATION "${dy_tracy_stage}/cmake")
    get_filename_component(dy_tracy_repo_root "${CMAKE_CURRENT_LIST_DIR}/../../../.." ABSOLUTE)
    execute_process(COMMAND "${GIT_EXECUTABLE}" apply --unsafe-paths
        "--directory=${dy_tracy_stage}" "${CMAKE_CURRENT_LIST_DIR}/../patches/tracy-v0.13.1-embedded.patch"
        WORKING_DIRECTORY "${dy_tracy_repo_root}"
        RESULT_VARIABLE dy_tracy_patch_result ERROR_VARIABLE dy_tracy_patch_error)
    if(NOT dy_tracy_patch_result EQUAL 0)
        message(FATAL_ERROR "Pinned Tracy patch failed: ${dy_tracy_patch_error}")
    endif()
    file(STRINGS "${dy_tracy_stage}/profiler/src/profiler/TracyView.hpp" dy_tracy_access REGEX "GetEmbeddedWorker")
    if(NOT dy_tracy_access)
        message(FATAL_ERROR "Pinned Tracy patch was skipped; embedded Worker access is missing")
    endif()
    file(GLOB_RECURSE dy_tracy_staged_files RELATIVE "${dy_tracy_stage}" "${dy_tracy_stage}/*")
    foreach(relative IN LISTS dy_tracy_staged_files)
        get_filename_component(parent "${dy_viewer_tracy_SOURCE_DIR}/${relative}" DIRECTORY)
        file(MAKE_DIRECTORY "${parent}")
        configure_file("${dy_tracy_stage}/${relative}" "${dy_viewer_tracy_SOURCE_DIR}/${relative}" COPYONLY)
    endforeach()
    file(WRITE "${dy_tracy_stamp}" "${dy_tracy_source_key}")
endif()

