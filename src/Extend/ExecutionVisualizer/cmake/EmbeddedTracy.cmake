add_library(dy_viewer_embedded_tracy STATIC
    "${CMAKE_CURRENT_LIST_DIR}/../EmbeddedTracy.cpp"
    "${CMAKE_CURRENT_LIST_DIR}/../Process.cpp")
target_link_libraries(dy_viewer_embedded_tracy PUBLIC dy_imgui PRIVATE shell32 ws2_32 iphlpapi)
target_compile_features(dy_viewer_embedded_tracy PUBLIC cxx_std_20)
target_compile_definitions(dy_viewer_embedded_tracy PUBLIC DY_VIEWER_EMBED_TRACY=$<BOOL:${DY_VIEWER_EMBED_TRACY}>)
