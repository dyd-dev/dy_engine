include_guard(GLOBAL)

function(_dyf_asset_file_ready path result)
    set(ready FALSE)
    if(EXISTS "${path}" AND NOT IS_DIRECTORY "${path}")
        file(SIZE "${path}" size)
        if(size GREATER 0)
            set(ready TRUE)
        endif()
    endif()
    set("${result}" "${ready}" PARENT_SCOPE)
endfunction()

function(_dyf_asset_archive_ready destination marker result)
    set(ready TRUE)
    if(ARGN)
        foreach(relative IN LISTS ARGN)
            _dyf_asset_file_ready("${destination}/${relative}" present)
            if(NOT present)
                set(ready FALSE)
                break()
            endif()
        endforeach()
    else()
        _dyf_asset_file_ready("${destination}/${marker}" ready)
    endif()
    set("${result}" "${ready}" PARENT_SCOPE)
endfunction()

function(_dyf_asset_fetch_file destination url work_directory)
    _dyf_asset_file_ready("${destination}" ready)
    if(ready)
        return()
    endif()
    if(IS_DIRECTORY "${destination}")
        message(FATAL_ERROR "Expected an asset file, but found a directory: ${destination}")
    endif()
    get_filename_component(parent "${destination}" DIRECTORY)
    file(MAKE_DIRECTORY "${parent}" "${work_directory}")
    string(SHA256 file_id "${destination}")
    set(partial "${work_directory}/${file_id}.part")
    file(REMOVE "${partial}")
    message(STATUS "Downloading Showcase asset: ${destination}")
    file(DOWNLOAD "${url}" "${partial}"
        TLS_VERIFY ON SHOW_PROGRESS INACTIVITY_TIMEOUT 90 STATUS status)
    list(GET status 0 code)
    list(GET status 1 reason)
    _dyf_asset_file_ready("${partial}" downloaded)
    if(NOT code EQUAL 0 OR NOT downloaded)
        file(REMOVE "${partial}")
        message(FATAL_ERROR "Could not download ${url}: ${reason}. Destination: ${destination}")
    endif()
    file(RENAME "${partial}" "${destination}")
endfunction()

# Both public helpers run at configure time. Lock files remain in the shared
# download cache so concurrent CMake processes always lock the same inode.
function(dyf_download_asset_file destination url)
    get_filename_component(destination "${destination}" ABSOLUTE)
    _dyf_asset_file_ready("${destination}" ready)
    if(ready)
        return()
    endif()
    set(work_directory "${DY_ASSET_ROOT}/.download")
    file(MAKE_DIRECTORY "${work_directory}")
    string(SHA256 lock_id "${destination}")
    file(LOCK "${work_directory}/${lock_id}.lock"
        GUARD FUNCTION TIMEOUT 60 RESULT_VARIABLE lock_result)
    if(NOT lock_result STREQUAL "0")
        message(FATAL_ERROR "Could not lock Showcase asset ${destination}: ${lock_result}")
    endif()
    # Another configure may have completed the download while this one waited.
    _dyf_asset_fetch_file("${destination}" "${url}" "${work_directory}")
endfunction()

function(dyf_download_asset_archive destination url archive_name)
    cmake_parse_arguments(ARG "" "ROOT" "REQUIRED_FILES" ${ARGN})
    if(ARG_UNPARSED_ARGUMENTS OR ARG_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "Invalid arguments for Showcase archive ${archive_name}.")
    endif()
    get_filename_component(name "${archive_name}" NAME)
    if(NOT name STREQUAL archive_name OR archive_name MATCHES "[/\\\\]" OR name STREQUAL "" OR
            name STREQUAL "." OR name STREQUAL "..")
        message(FATAL_ERROR "Showcase archive_name must be a basename: ${archive_name}")
    endif()
    foreach(relative IN ITEMS "${ARG_ROOT}" ${ARG_REQUIRED_FILES})
        if(IS_ABSOLUTE "${relative}" OR relative MATCHES "(^|[/\\\\])\\.\\.([/\\\\]|$)")
            message(FATAL_ERROR "Showcase archive paths must stay inside the archive: ${relative}")
        endif()
    endforeach()
    get_filename_component(destination "${destination}" ABSOLUTE)
    string(SHA256 package_id "${url}|${archive_name}|${ARG_ROOT}")
    set(marker ".dy-showcase-asset-${package_id}.complete")
    _dyf_asset_archive_ready("${destination}" "${marker}" ready ${ARG_REQUIRED_FILES})
    if(ready)
        return()
    endif()
    if(EXISTS "${destination}" AND NOT IS_DIRECTORY "${destination}")
        message(FATAL_ERROR "Expected a Showcase asset directory: ${destination}")
    endif()
    get_filename_component(cache_root "${DY_ASSET_ROOT}" ABSOLUTE)
    set(work_directory "${cache_root}/.download")
    set(archive "${cache_root}/${archive_name}")
    file(MAKE_DIRECTORY "${work_directory}")
    string(SHA256 lock_id "${destination}")
    file(LOCK "${work_directory}/${lock_id}.lock"
        GUARD FUNCTION TIMEOUT 60 RESULT_VARIABLE lock_result)
    if(NOT lock_result STREQUAL "0")
        message(FATAL_ERROR "Could not lock Showcase asset ${destination}: ${lock_result}")
    endif()
    _dyf_asset_archive_ready("${destination}" "${marker}" ready ${ARG_REQUIRED_FILES})
    if(ready)
        return()
    endif()
    # Different destinations may share the same cached original archive.
    string(SHA256 archive_lock_id "${archive}")
    file(LOCK "${work_directory}/${archive_lock_id}.lock"
        GUARD FUNCTION TIMEOUT 60 RESULT_VARIABLE lock_result)
    if(NOT lock_result STREQUAL "0")
        message(FATAL_ERROR "Could not lock Showcase archive ${archive}: ${lock_result}")
    endif()
    _dyf_asset_fetch_file("${archive}" "${url}" "${work_directory}")
    set(staging "${work_directory}/${lock_id}.extract")
    file(REMOVE_RECURSE "${staging}")
    file(MAKE_DIRECTORY "${staging}")
    message(STATUS "Extracting Showcase asset: ${archive_name}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xf "${archive}"
        WORKING_DIRECTORY "${staging}"
        RESULT_VARIABLE extract_result OUTPUT_VARIABLE extract_output ERROR_VARIABLE extract_error)
    if(NOT extract_result STREQUAL "0")
        file(REMOVE_RECURSE "${staging}")
        message(FATAL_ERROR
            "Could not extract ${archive}: ${extract_error}. "
            "If the cached archive is damaged, remove it and configure again.")
    endif()
    set(source "${staging}")
    if(NOT ARG_ROOT STREQUAL "")
        set(source "${staging}/${ARG_ROOT}")
    endif()
    if(NOT IS_DIRECTORY "${source}")
        file(REMOVE_RECURSE "${staging}")
        message(FATAL_ERROR "Archive ${archive_name} does not contain ROOT ${ARG_ROOT}.")
    endif()
    if(ARG_REQUIRED_FILES)
        _dyf_asset_archive_ready("${source}" "${marker}" ready ${ARG_REQUIRED_FILES})
        if(NOT ready)
            file(REMOVE_RECURSE "${staging}")
            message(FATAL_ERROR
                "Archive ${archive_name} is missing required files below ROOT '${ARG_ROOT}': ${ARG_REQUIRED_FILES}")
        endif()
    endif()
    if(NOT EXISTS "${destination}")
        get_filename_component(parent "${destination}" DIRECTORY)
        file(MAKE_DIRECTORY "${parent}")
        file(RENAME "${source}" "${destination}")
    else()
        # Repair incomplete packages without replacing files supplied by users.
        file(GLOB_RECURSE files LIST_DIRECTORIES FALSE RELATIVE "${source}" "${source}/*")
        foreach(relative IN LISTS files)
            if(NOT EXISTS "${destination}/${relative}")
                get_filename_component(parent "${destination}/${relative}" DIRECTORY)
                file(MAKE_DIRECTORY "${parent}")
                file(COPY "${source}/${relative}" DESTINATION "${parent}")
            endif()
        endforeach()
    endif()
    file(REMOVE_RECURSE "${staging}")
    if(ARG_REQUIRED_FILES)
        _dyf_asset_archive_ready("${destination}" "${marker}" ready ${ARG_REQUIRED_FILES})
        if(NOT ready)
            message(FATAL_ERROR
                "Showcase asset ${destination} is still incomplete. Existing files were preserved; "
                "remove or replace empty/conflicting required files: ${ARG_REQUIRED_FILES}")
        endif()
    endif()
    file(WRITE "${destination}/${marker}.part" "${url}\n")
    file(RENAME "${destination}/${marker}.part" "${destination}/${marker}")
endfunction()
